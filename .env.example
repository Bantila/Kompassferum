# Подключение backend -> postgres (внутри docker-сети хост = имя сервиса)
DATABASE_URL=postgresql+asyncpg://kompas:kompas@postgres:5432/kompas

# Учётка postgres-контейнера (должна совпадать с DATABASE_URL)
POSTGRES_USER=kompas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kompas

# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# Модель для рекомендаций (slug OpenRouter)
OPENROUTER_MODEL=moonshotai/kimi-k2

# Секрет для проверки заголовка X-Max-Signature на вебхуке MAX
MAX_WEBHOOK_SECRET=your_secret_here

# Секрет для подписи JWT — обязательно свой на стенде (любая длинная случайная строка)
JWT_SECRET=change_me_to_a_long_random_string
