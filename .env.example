# Подключение backend -> postgres (внутри docker-сети хост = имя сервиса) 
# DATABASE_URL=postgresql+asyncpg://kompas:kompas@postgres:5432/kompas       # переехал в docker-compose.yml

# Учётка postgres-контейнера (должна совпадать с DATABASE_URL)
POSTGRES_USER=kompas
#изменить с помощью команды: openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
POSTGRES_PASSWORD=
POSTGRES_DB=kompas

# Ключ OpenRouter: https://openrouter.ai/keys
# Кто подбирает профессии: gigachat | openrouter | none
# none — всегда запасной rule-based алгоритм, ключи не нужны
AI_PROVIDER=gigachat

# GigaChat: Authorization key из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS для физлиц, GIGACHAT_API_B2B и _CORP для компаний
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat | GigaChat-2-Pro | GigaChat-2-Max
GIGACHAT_MODEL=GigaChat
# Сбер подписан НУЦ Минцифры, которого нет в стандартном наборе сертификатов.
# Поставили сертификат на сервер — укажите путь и оставьте проверку включённой.
GIGACHAT_CA_BUNDLE=
# false отключает проверку TLS: годится для пробы, для боевого стенда — нет
GIGACHAT_VERIFY_SSL=true

OPENROUTER_API_KEY=your_key_here

# Модель для рекомендаций (slug OpenRouter)
OPENROUTER_MODEL=moonshotai/kimi-k2

# Секрет подписки MAX — возвращается в заголовке X-Max-Bot-Api-Secret.
# Только буквы, цифры и дефис, 5–256 символов: openssl rand -hex 32
MAX_WEBHOOK_SECRET=your_secret_here

# Секрет для подписи JWT — обязательно свой на стенде (любая длинная случайная строка)
#сгенерировать с помощью команды: openssl rand -hex 64
JWT_SECRET=

# Чат-бот. MAX — целевая платформа, Telegram — площадка для отладки,
# пока нет доступа к MAX. Ядро сценариев общее, отличаются только адаптеры.
MAX_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# имя бота без @ — приложение показывает по нему ссылку на вход
TELEGRAM_BOT_USERNAME=
# сгенерировать с помощью команды: openssl rand -base64 64 | tr -dc 'A-Za-z0-9' | head -c 32
TELEGRAM_WEBHOOK_SECRET=    

# Адрес мини-приложения — бот присылает на него кнопку
APP_PUBLIC_URL=https://testmaxapp.vltx.eu.cc
